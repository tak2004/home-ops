network:
  version: 2
  renderer: networkd
  ethernets:
    # Named interface instead of a match on "en*": the wildcard also matched the
    # USB ethernet adapter on backbone-1, so both NICs ended up with one address.
    {{ nic }}:
      optional: true
      addresses:
        - {{ static_ip }}/24
      routes:
        - to: default
          via: {{ gateway_ip }}
      nameservers:
        addresses:
          - 8.8.8.8
          - 8.8.4.4
