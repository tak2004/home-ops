network:
  version: 2
  renderer: networkd
  ethernets:
    # Named interface instead of a match on "en*": the wildcard also matched the
    # USB ethernet adapter on backbone-1, so both NICs ended up with one address.
    {{ nic }}:
      optional: true
      addresses:
        - {{ static_ip }}/24
      routes:
        - to: default
          via: {{ gateway_ip }}
      nameservers:
        addresses:
          - 8.8.8.8
          - 8.8.4.4
{% if replication_ip is defined %}
    # Dedicated storage link, cabled point to point. No gateway and no nameserver:
    # nothing but DRBD replication is routed here.
    {{ replication_nic }}:
      optional: true
      mtu: {{ replication_mtu }}
      addresses:
        - {{ replication_ip }}/{{ replication_mask }}
{% endif %}
