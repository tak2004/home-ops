network:
  version: 2
  renderer: networkd
  ethernets:
    # Konkretes Interface statt match "en*": der Wildcard-Match traf auf backbone-1
    # auch den USB-Ethernet-Adapter, beide NICs bekamen dieselbe Adresse.
    {{ nic }}:
      optional: true
      addresses:
        - {{ static_ip }}/24
      routes:
        - to: default
          via: {{ gateway_ip }}
      nameservers:
        addresses:
          - 8.8.8.8
          - 8.8.4.4
