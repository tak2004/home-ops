redis-ha:
  enabled: true

controller:
  replicas: 1

server:
  autoscaling:
    enabled: true
    minReplicas: 2
  # Reached through the shared cilium-ingress, which the *.{{ k8s_subdomain }}.{{ dns_zone }}
  # wildcard in bind9 resolves to -- no dedicated LoadBalancer IP or DNS record needed.
  ingress:
    enabled: true
    ingressClassName: cilium
    hostname: {{ argocd_domain }}
    annotations:
      # cert-manager issues the certificate from the private home-ca.
      cert-manager.io/cluster-issuer: home-ca
      # Picked up by the homepage dashboard, which reads ingresses itself.
      gethomepage.dev/enabled: "true"
      gethomepage.dev/name: "Argo CD"
      gethomepage.dev/group: "Cluster"
      gethomepage.dev/icon: argo-cd.svg
      gethomepage.dev/description: "GitOps, deployt alles hier"
    tls: true

configs:
  # Argo resolves "$name:key" only against secrets carrying the
  # app.kubernetes.io/part-of: argocd label -- see resources/argocd-oidc.yaml in the
  # apps repository, where the sealed half lives.
  cm:
    url: https://{{ argocd_domain }}
    oidc.config: |
      name: Authelia
      issuer: https://{{ authelia_domain }}
      clientID: argocd
      clientSecret: $argocd-oidc:clientSecret
      requestedScopes: ['openid', 'profile', 'email', 'groups']
      # Argo fetches the discovery document and the signing keys itself and has to
      # trust the private CA for it. The certificate is public -- it is the root
      # that every browser here already imports -- so it lives in the repository
      # rather than in a secret.
      rootCA: |
{{ lookup('file', 'home-ca.crt') | indent(8, true) }}
  rbac:
    # Without the scopes line Argo only looks at the sub claim and the group never
    # matches. The built-in admin stays enabled as the way in when this is broken.
    scopes: '[groups]'
    policy.csv: |
      g, {{ argocd_admin_group }}, role:admin
  params:
    # Argo CD serves HTTPS with its own self-signed certificate by default. Behind an
    # ingress that means double TLS, so the server runs plain HTTP here and the ingress
    # terminates the connection.
    server.insecure: true

repoServer:
  autoscaling:
    enabled: true
    minReplicas: 2

applicationSet:
  replicas: 2
